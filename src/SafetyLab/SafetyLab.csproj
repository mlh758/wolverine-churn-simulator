<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SafetyLab</RootNamespace>
    <AssemblyName>safetylab</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately NOT a Wolverine reference. The monitor is an outside observer:
         it must be able to watch a cluster running any Wolverine version (5.39,
         stock main, the proposal build) without sharing a line of code with it. -->
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

</Project>
