{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": { "name": "churnsim", "namespace": "default" },
  "spec": {
    "replicas": 3,
    "template": {
      "spec": {
        "containers": [
          {
            "name": "churnsim",
            "image": "localhost/churnsim:local",
            "env": [
              { "name": "POSTGRES_CONNECTION", "value": "Host=pg;Database=churnsim;Username=postgres;Password=postgres" },
              {
                "name": "POD_NAME",
                "valueFrom": { "fieldRef": { "apiVersion": "v1", "fieldPath": "metadata.name" } }
              },
              { "name": "SIM_AGENT_COUNT", "value": "500" },
              { "name": "ROLLOUT_STAMP", "value": "initial" }
            ]
          }
        ]
      }
    }
  }
}
