<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Locally packed Wolverine builds, for bisecting against a branch or a pre-release.
         Normally EMPTY: the rig tracks current Wolverine from nuget.org, and the pre-6.36
         builds this was created for are gone (see ARCHIVED_RESULTS.md). The directory must
         still exist, because the Dockerfile COPYs it. README.md has the pack recipe. -->
    <add key="local" value="localfeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
